# ==============================================================================
# Semantic Video Retrieval - Environment Configuration Template
# ==============================================================================

# Application & Environment
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
API_PREFIX=/api
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Security & Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_PER_MIN=120
RATE_LIMIT_SEARCH_PER_MIN=60
RATE_LIMIT_UPLOAD_PER_MIN=15

# Storage & Database Paths (relative to repository root or absolute)
DATA_DIR=data
VIDEOS_DIR=data/videos
AUDIO_DIR=data/audio
FRAMES_DIR=data/frames
INDEXES_DIR=data/indexes
TEMP_DIR=data/temp
DATABASE_URL=sqlite:///./data/metadata.db

# Ingestion & Upload Constraints
MAX_UPLOAD_SIZE_MB=500
ALLOWED_EXTENSIONS=[".mp4",".mkv",".mov",".avi",".webm"]

# Deep Learning Models
WHISPER_MODEL=base
WHISPER_DEVICE=auto
TEXT_EMBEDDING_MODEL=all-MiniLM-L6-v2
TEXT_EMBEDDING_DIM=384
VISION_MODEL=openai/clip-vit-base-patch32
VISION_EMBEDDING_DIM=512

# Temporal Segmentation & Indexing
CHUNK_TARGET_DURATION_SEC=20.0
CHUNK_MAX_WORDS=60
CHUNK_MAX_PAUSE_SEC=2.0
FRAME_SAMPLE_INTERVAL_SEC=2.0
